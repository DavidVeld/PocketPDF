<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PocketPDF.Core\PocketPDF.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the Windows colour dialog (custom colours); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WPF0001: the Fluent theme (ThemeMode) is marked experimental; it's the built-in Windows 11 look. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms' implicit usings clash with WPF's names (Point, Brush, KeyEventArgs...); the colour dialog is named in full. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Version 0.x.y from the number of commits since 21f04cb: every commit is a new version, 0.0.1 to 0.0.999, then
       0.1.0. Nothing to bump by hand, and nothing written back into the repository on build. Without git (a downloaded
       zip) it stays at the SDK's 1.0.0. Check the rollover with dotnet build -p:BuildNumber=1000 (gives 0.1.0). -->
  <Target Name="SetVersionFromGit" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Condition="'$(BuildNumber)' == ''" Command="git rev-list --count 21f04cb..HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildNumber" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(GitExitCode)' == '0' Or ('$(GitExitCode)' == '' And '$(BuildNumber)' != '')">
      <Version>0.$([System.Math]::Floor($([MSBuild]::Divide($(BuildNumber), 1000)))).$([MSBuild]::Modulo($(BuildNumber), 1000))</Version>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- The 256 px icon for the start screen; the .ico would give WPF its 16 px image. Made by img/make-icon.ps1. -->
    <Resource Include="..\..\img\icon.png" Link="icon.png" />
  </ItemGroup>

</Project>
