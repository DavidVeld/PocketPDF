<Window x:Class="PurpleStreamPDF.CombineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PurpleStreamPDF"
        Title="Combine PDFs – PurpleStreamPDF" Width="620" Height="560" MinWidth="460" MinHeight="360"
        Icon="app.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Combine PDFs" FontSize="20" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Margin="0,4,0,12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="All pages go into one PDF in this order, which starts as name order: Explorer doesn&apos;t tell programs which file you clicked first. Drag or use the buttons to change it." />

        <!-- Bottom: where it goes, then the buttons. -->
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="Save as" Margin="0,12,0,4" />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="FolderText" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="260"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="NameBox" />
            </DockPanel>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OpenButton" Click="OnOpenResult" Visibility="Collapsed" Margin="0,0,8,0" Padding="14,5">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /><TextBlock Text="Open" /></StackPanel>
                </Button>
                <Button x:Name="ShowInFolderButton" Click="OnShowInFolder" Visibility="Collapsed" Margin="0,0,8,0" Padding="14,5">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" /><TextBlock Text="Show in folder" /></StackPanel>
                </Button>
                <Button x:Name="CombineButton" Click="OnCombine" IsDefault="True" IsEnabled="False" Margin="0,0,8,0" Padding="14,5"
                        Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" /><TextBlock Text="Combine" /></StackPanel>
                </Button>
                <Button x:Name="CloseButton" Content="Cancel" IsCancel="True" Padding="14,5" Click="OnClose" />
            </StackPanel>
        </StackPanel>

        <!-- Right: list actions. -->
        <StackPanel DockPanel.Dock="Right" Width="140" Margin="10,0,0,0">
            <Button Style="{StaticResource SideButton}" Click="OnMoveUp" ToolTip="Move the selected file up (Alt+Up)">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" /><TextBlock Text="Move up" /></StackPanel>
            </Button>
            <Button Style="{StaticResource SideButton}" Click="OnMoveDown" ToolTip="Move the selected file down (Alt+Down)">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" /><TextBlock Text="Move down" /></StackPanel>
            </Button>
            <Button Style="{StaticResource SideButton}" Click="OnSortByName" ToolTip="Sort by file name, numbers in number order (S-2 before S-10)">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" /><TextBlock Text="Sort by name" /></StackPanel>
            </Button>
            <Button Style="{StaticResource SideButton}" Click="OnRemove" ToolTip="Leave the selected file out (Delete)">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" /><TextBlock Text="Remove" /></StackPanel>
            </Button>
        </StackPanel>

        <ListBox x:Name="FileList" AllowDrop="True" KeyDown="OnFileListKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="OnFileMouseDown" PreviewMouseMove="OnFileMouseMove" Drop="OnFileDrop">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,3" ToolTip="{Binding}">
                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76F;" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Converter={x:Static local:PathParts.FileName}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Converter={x:Static local:PathParts.Folder}}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
