<Window x:Class="PurpleStreamPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PurpleStreamPDF"
        Title="PurpleStreamPDF" Height="800" Width="1200" UseLayoutRounding="True" Icon="app.ico"
        AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp" PreviewTextInput="OnPreviewTextInput">
    <Window.Resources>
        <!-- Toolbar icons are glyphs from the Windows icon font (Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on 10). -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ToolIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Margin" Value="2,0" />
        </Style>
        <!-- Menu items show the same icon as their button. -->
        <Style x:Key="MenuIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- Tools are radio buttons (one at a time) drawn as toggle buttons; the Fluent theme would draw radio circles.
             The toolbar gives its radio buttons the style under this key, so it has to be replaced here. -->
        <Style x:Key="{x:Static ToolBar.RadioButtonStyleKey}" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="GroupName" Value="Tools" /> <!-- one tool at a time across both tool bars -->
        </Style>
        <!-- Drawn icons for the area tools, in the style of the font icons: a label box top-left with a leader down to the
             area (a box, a cloud, or nothing for a tag). Drawn 1:1 on a 20 x 20 pixel grid with 1 px lines on half pixels,
             so they stay sharp. They take the button's text colour, so they follow the theme and grey out with it. -->
        <Style x:Key="IconLine" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="IconFill" TargetType="Path">
            <Setter Property="Fill" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        </Style>
        <!-- The width of a font icon with its margins, and no taller than its line. -->
        <Style x:Key="DrawnIcon" TargetType="Grid">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Geometry x:Key="IconLabel">M1.5,1.5 H9.5 V6.5 H1.5 Z</Geometry>
        <Geometry x:Key="IconLeader">M7,7 L9.7,9.7</Geometry>
        <Geometry x:Key="IconArrow">M12,12 V8 L8,12 Z</Geometry>
        <Geometry x:Key="IconTagLeader">M7,7 L15.7,15.7</Geometry>
        <Geometry x:Key="IconTagArrow">M18,18 V14 L14,18 Z</Geometry>
        <Geometry x:Key="IconBox">M6.5,13.5 H18.5 V18.5 H6.5 Z</Geometry>
        <Geometry x:Key="IconAreaCloud">M7.5,14.5 A1.5,1.5 0 0 1 10.5,14.5 A1.5,1.5 0 0 1 13.5,14.5 A1.5,1.5 0 0 1 16.5,14.5 A1.5,1.5 0 0 1 16.5,17.5 A1.5,1.5 0 0 1 13.5,17.5 A1.5,1.5 0 0 1 10.5,17.5 A1.5,1.5 0 0 1 7.5,17.5 A1.5,1.5 0 0 1 7.5,14.5 Z</Geometry>
        <Geometry x:Key="IconCloud">M15.54,12.3 A2.76,2.76 0 1 1 12.3,15.54 A2.76,2.76 0 1 1 7.7,15.54 A2.76,2.76 0 1 1 4.46,12.3 A2.76,2.76 0 1 1 4.46,7.7 A2.76,2.76 0 1 1 7.7,4.46 A2.76,2.76 0 1 1 12.3,4.46 A2.76,2.76 0 1 1 15.54,7.7 A2.76,2.76 0 1 1 15.54,12.3 Z</Geometry>
        <Geometry x:Key="IconStraightLine">M3,17 L17,3</Geometry>
        <Geometry x:Key="IconCadLine">M4,16 L16,4</Geometry>
        <Geometry x:Key="IconCadLineEnds">M2.5,14.5 h3 v3 h-3 Z M14.5,2.5 h3 v3 h-3 Z</Geometry>
        <Geometry x:Key="IconCadPolyline">M3,17 L6,6 L13,14 L17,3</Geometry>
        <Geometry x:Key="IconCadRectangle">M4,6 H16 V14 H4 Z</Geometry>
        <Geometry x:Key="IconCadRectangleCorners">M2.5,12.5 h3 v3 h-3 Z M14.5,4.5 h3 v3 h-3 Z</Geometry>
        <!-- Two line ends, each with its grip, and the dotted gap the join closes. -->
        <Geometry x:Key="IconCadJoin">M1,10 H4 M16,10 H19</Geometry>
        <Geometry x:Key="IconCadJoinCorners">M4,8.5 h3 v3 h-3 Z M13,8.5 h3 v3 h-3 Z M8.5,9.5 h1 v1 h-1 Z M10.5,9.5 h1 v1 h-1 Z</Geometry>
        <!-- Rotate clockwise: three quarters of a turn ending in an arrow head. Mirrored, counter-clockwise. -->
        <Geometry x:Key="IconRotate">M5,14 A6,6 0 1 1 15.2,13.2</Geometry>
        <Geometry x:Key="IconRotateHead">M12.8,12 L17.8,12 L15.3,16 Z</Geometry>
        <Geometry x:Key="IconCadCircle">M10,3 A7,7 0 1 1 9.99,3 Z M9,10 h2 M10,9 v2</Geometry>
        <Geometry x:Key="IconCadOffset">M3,12 L12,3 M8,17 L17,8</Geometry>
        <Geometry x:Key="IconCadTrim">M3,10 H8 M12,10 H17 M8,3 V17 M12,3 V17</Geometry>
        <Geometry x:Key="IconCadHatch">M3.5,3.5 H16.5 V16.5 H3.5 Z M3.5,9.5 L9.5,3.5 M3.5,15.5 L15.5,3.5 M9.5,16.5 L16.5,9.5</Geometry>
        <!-- A drafting dimension: extension lines, the dimension line with oblique ticks, and the value above it. -->
        <Geometry x:Key="IconCadDimension">M3,5 V17 M17,5 V17 M1.5,13 H18.5 M1.5,14.5 L4.5,11.5 M15.5,14.5 L18.5,11.5 M7,9 H13</Geometry>
        <!-- The page buttons in the status bar: flat, with a small icon. -->
        <Style x:Key="PageButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="PageIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>
    <Grid>
    <DockPanel>
        <!-- File and Edit commands live in this menu only. Every drawing tool is both a button in the bar down the right
             and an item under Tools: a new tool needs both. Keys are handled in OnPreviewKeyDown; the menus just show them. -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New…" InputGestureText="Ctrl+N" Click="OnNew" ToolTip="A blank sheet to draw on: A4 to A0 or your own size">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7C3;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="OnOpen">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8E5;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="RecentMenu" Header="Open _Recent">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE81C;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="SaveMenuItem" Header="_Save" InputGestureText="Ctrl+S" Click="OnSave" IsEnabled="False">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74E;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="SaveAsMenuItem" Header="Save _As…" InputGestureText="Ctrl+Shift+S" Click="OnSaveAs" IsEnabled="False">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE792;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="CloseMenuItem" Header="_Close" InputGestureText="Ctrl+W" Click="OnCloseDocument" IsEnabled="False">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE711;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="PrintMenuItem" Header="_Print…" InputGestureText="Ctrl+P" Click="OnPrint" IsEnabled="False">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE749;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7E8;" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="OnUndo" IsEnabled="{Binding IsEnabled, ElementName=UndoButton}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7A7;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="OnRedo" IsEnabled="{Binding IsEnabled, ElementName=RedoButton}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7A6;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="OnCopy">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="OnPaste" ToolTip="Paste at the cursor">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE77F;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Paste in _place" InputGestureText="Ctrl+Shift+V" Click="OnPasteInPlace" ToolTip="Paste at the same spot on the sheet: onto this page, or for markups copied from several pages, onto those pages">
                    <MenuItem.Icon><Grid><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE77F;" /><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE718;" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-3" /></Grid></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Delete" InputGestureText="Del" Click="OnDelete">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74D;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Click="OnSelectAll" ToolTip="All markups on this page; again for all markups in the document">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8B3;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Pr_operties" InputGestureText="Alt+Enter" Click="OnMarkupProperties" ToolTip="Who drew the selected markup and when, and who last changed it">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE946;" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="LineWeightsMenuItem" Header="Line _weights" IsCheckable="True" IsChecked="True" Click="OnLineWeightsToggled"
                          ToolTip="Off draws every line of the drawing one pixel wide, for easier reading. Markups, printing and saved files keep their line weights.">
                    <MenuItem.Icon><Viewbox Width="16" Height="16"><Grid Style="{StaticResource DrawnIcon}"><Path Style="{StaticResource IconLine}" Data="M3,4.5 H17" /><Path Style="{StaticResource IconLine}" Data="M3,10 H17" StrokeThickness="2" /><Path Style="{StaticResource IconLine}" Data="M3,15.5 H17" StrokeThickness="3" /></Grid></Viewbox></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="CadLayerMenuItem" Header="Show CAD _layer" IsCheckable="True" IsChecked="True" Click="OnCadLayerToggled"
                          ToolTip="Shows or hides everything drawn with the CAD tools. It is saved on its own layer named CAD, which other viewers can switch too">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE81E;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="DarkModeMenuItem" Header="_Dark mode" IsCheckable="True" Click="OnDarkModeToggled"
                          ToolTip="The window in dark colours. The drawing itself stays white">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE708;" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Select" InputGestureText="V" Tag="SelectTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=SelectTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=SelectTool}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8B0;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Select te_xt" InputGestureText="S" Tag="SelectTextTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=SelectTextTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=SelectTextTool}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C1;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Text" InputGestureText="T" Tag="TextTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=TextTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=TextTool}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8AC;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Callout" InputGestureText="C" Tag="CalloutTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=CalloutTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=CalloutTool}">
                    <MenuItem.Icon><Viewbox Width="16" Height="16"><Grid Style="{StaticResource DrawnIcon}"><Path Style="{StaticResource IconLine}" Data="{StaticResource IconLabel}" /><Path Style="{StaticResource IconLine}" Data="{StaticResource IconLeader}" /><Path Style="{StaticResource IconLine}" Data="{StaticResource IconBox}" /><Path Style="{StaticResource IconFill}" Data="{StaticResource IconArrow}" /></Grid></Viewbox></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Ta_g" InputGestureText="G" Tag="TagTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=TagTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=TagTool}">
                    <MenuItem.Icon><Viewbox Width="16" Height="16"><Grid Style="{StaticResource DrawnIcon}"><Path Style="{StaticResource IconLine}" Data="{StaticResource IconLabel}" /><Path Style="{StaticResource IconLine}" Data="{StaticResource IconTagLeader}" /><Path Style="{StaticResource IconFill}" Data="{StaticResource IconTagArrow}" /></Grid></Viewbox></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Clou_d" InputGestureText="K" Tag="CloudTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=CloudTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=CloudTool}">
                    <MenuItem.Icon><Viewbox Width="16" Height="16"><Grid Style="{StaticResource DrawnIcon}"><Path Style="{StaticResource IconLine}" Data="{StaticResource IconCloud}" /></Grid></Viewbox></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Pen" InputGestureText="P" Tag="PenTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=PenTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=PenTool}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xEE56;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Highlight" InputGestureText="H" Tag="HighlightTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=HighlightTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=HighlightTool}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7E6;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Line" InputGestureText="L" Tag="LineTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=LineTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=LineTool}">
                    <MenuItem.Icon><Viewbox Width="16" Height="16"><Grid Style="{StaticResource DrawnIcon}"><Path Style="{StaticResource IconLine}" Data="{StaticResource IconStraightLine}" /></Grid></Viewbox></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Rectangle" InputGestureText="R" Tag="RectangleTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=RectangleTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=RectangleTool}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE739;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Mask" InputGestureText="W" Tag="MaskTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=MaskTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=MaskTool}">
                    <MenuItem.Icon><Viewbox Width="16" Height="16"><Grid Style="{StaticResource DrawnIcon}"><Path Style="{StaticResource IconFill}" Data="M3,5 H17 V15 H3 Z" /></Grid></Viewbox></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Measure" InputGestureText="M" Tag="MeasureTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=MeasureTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=MeasureTool}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xED5E;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Cali_brate…" Click="OnCalibrate" IsEnabled="{Binding IsEnabled, ElementName=CalibrateButton}">
                    <MenuItem.Icon><Grid><TextBlock Style="{StaticResource MenuIcon}" Text="&#xED5E;" /><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE713;" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-3" /></Grid></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Check text _overlaps" Click="OnFindOverlaps" IsEnabled="{Binding IsEnabled, ElementName=OverlapsButton}"
                          ToolTip="{Binding ToolTip, ElementName=OverlapsButton}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE9D5;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Place PDF or _image…" Click="OnPlaceSheet" IsEnabled="{Binding IsEnabled, ElementName=PlaceSheetButton}"
                          ToolTip="{Binding ToolTip, ElementName=PlaceSheetButton}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8B9;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Rotate page cl_ockwise" Click="OnRotateClockwise" IsEnabled="{Binding IsEnabled, ElementName=RotateClockwiseButton}">
                    <MenuItem.Icon><Viewbox Width="16" Height="16"><Grid Style="{StaticResource DrawnIcon}"><Path Style="{StaticResource IconLine}" Data="{StaticResource IconRotate}" StrokeThickness="1.4" /><Path Style="{StaticResource IconFill}" Data="{StaticResource IconRotateHead}" /></Grid></Viewbox></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Rotate page cou_nter-clockwise" Click="OnRotateCounterClockwise" IsEnabled="{Binding IsEnabled, ElementName=RotateCounterClockwiseButton}">
                    <MenuItem.Icon><Viewbox Width="16" Height="16" RenderTransformOrigin="0.5,0.5"><Viewbox.RenderTransform><ScaleTransform ScaleX="-1" /></Viewbox.RenderTransform><Grid Style="{StaticResource DrawnIcon}"><Path Style="{StaticResource IconLine}" Data="{StaticResource IconRotate}" StrokeThickness="1.4" /><Path Style="{StaticResource IconFill}" Data="{StaticResource IconRotateHead}" /></Grid></Viewbox></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Rotate page 1_80°" Click="OnRotate180" IsEnabled="{Binding IsEnabled, ElementName=Rotate180Button}">
                    <MenuItem.Icon><Viewbox Width="16" Height="16"><Grid Style="{StaticResource DrawnIcon}"><Path Style="{StaticResource IconLine}" Data="M3.5,11 A6.5,6.5 0 0 1 16.5,10" StrokeThickness="1.4" /><Path Style="{StaticResource IconFill}" Data="M14,9 L19,9 L16.5,13 Z" /><TextBlock Text="180" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-1" /></Grid></Viewbox></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="CompareMenuItem" Header="Com_pare with old revision…" Click="OnCompare"
                          ToolTip="Overlay an old revision of this drawing: old in red, new in blue, unchanged in black">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;" /></MenuItem.Icon>
                </MenuItem>
                <!-- Tool templates are hidden for now: drop the Visibility here and on the tool bar to bring them back. -->
                <Separator Visibility="Collapsed" />
                <MenuItem Header="Save tool as te_mplate…" Click="OnSaveTemplate" Visibility="Collapsed" ToolTip="Save the tool in use and its style under a name, as a button on the tool bar">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE710;" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_CAD tools" ToolTip="Experimental. On once the sheet has a scale (Tools ▸ Calibrate, or the scale in the status bar)">
                <MenuItem Header="_Line" Tag="CadLineTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=CadLineTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=CadLineTool}" />
                <MenuItem Header="_Polyline" Tag="CadPolylineTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=CadPolylineTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=CadPolylineTool}" />
                <MenuItem Header="_Rectangle" Tag="CadRectangleTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=CadRectangleTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=CadRectangleTool}" />
                <MenuItem Header="_Circle" Tag="CadCircleTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=CadCircleTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=CadCircleTool}" />
                <MenuItem Header="_Offset" Tag="CadOffsetTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=CadOffsetTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=CadOffsetTool}" />
                <MenuItem Header="_Trim" Tag="CadTrimTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=CadTrimTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=CadTrimTool}" />
                <MenuItem Header="_Hatch" Tag="CadHatchTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=CadHatchTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=CadHatchTool}" />
                <MenuItem Header="_Dimension" Tag="CadDimensionTool" Click="OnToolMenu" IsChecked="{Binding IsChecked, ElementName=CadDimensionTool, Mode=OneWay}" IsEnabled="{Binding IsEnabled, ElementName=CadDimensionTool}" />
                <MenuItem Header="_Join lines into polyline" Click="OnCadJoin" IsEnabled="{Binding IsEnabled, ElementName=CadJoinButton}" />
            </MenuItem>
            <MenuItem Header="_Help" SubmenuOpened="OnHelpMenuOpened">
                <MenuItem Header="Show me the _tricks" InputGestureText="F1" Click="OnShowTricks" ToolTip="A quick tour of the window">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE946;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- Its header says Add or Remove, set as the menu opens. -->
                <MenuItem x:Name="ExplorerMenuItem" Click="OnExplorerMenuItem"
                          ToolTip="Select PDFs in Explorer, right-click, and choose Combine PDFs (on Windows 11 under “Show more options”)">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE838;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Check for _updates" Click="OnCheckForUpdate" ToolTip="Compare this version with the latest release on GitHub">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE895;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_About PurpleStreamPDF" Click="OnAbout">
                    <MenuItem.Icon><Image Source="app.ico" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        <!-- Groups: Edit | Style. The select and drawing tools are in the bar down the right; the page list and fit are in the status bar. -->
        <ToolBar x:Name="MainToolBar" DockPanel.Dock="Top" ToolBarTray.IsLocked="True" Padding="4,2">
            <ToolBar.Resources>
                <!-- Room either side of each separator, so the line, text and area groups read apart. -->
                <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}">
                    <Setter Property="Margin" Value="12,2" />
                </Style>
            </ToolBar.Resources>
            <Button x:Name="UndoButton" Click="OnUndo" IsEnabled="False" ToolTip="Undo (Ctrl+Z)">
                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7A7;" />
            </Button>
            <Button x:Name="RedoButton" Click="OnRedo" IsEnabled="False" ToolTip="Redo (Ctrl+Y)">
                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7A6;" />
            </Button>
            <Separator />
            <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE790;" ToolTip="Colour" Margin="8,0,4,0" />
            <!-- The code puts a colour swatch in front of each name. -->
            <ComboBox x:Name="ColorPicker" Width="124" SelectedIndex="0" SelectionChanged="OnStyleChanged" ToolTip="Colour">
                <ComboBoxItem Content="Red" Tag="#E53935" />
                <ComboBoxItem Content="Blue" Tag="#1E88E5" />
                <ComboBoxItem Content="Green" Tag="#43A047" />
                <ComboBoxItem Content="Black" Tag="#000000" />
                <ComboBoxItem Content="Yellow" Tag="#FFFF00" />
                <ComboBoxItem x:Name="CustomColorItem" Content="Custom…" />
            </ComboBox>
            <ComboBox x:Name="LineEndPicker" Width="118" SelectedIndex="0" SelectionChanged="OnLineEndChanged" Margin="4,0,0,0"
                      ToolTip="Line end: how lines, callout leaders, tags and dimensions end. Changes the selected one too">
                <ComboBoxItem Tag="Arrow">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,7.5 H13" /><Path Style="{StaticResource IconFill}" Data="M18.5,7.5 L12.5,4.5 L12.5,10.5 Z" /></Grid>
                        <TextBlock Text="Arrow" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Dot">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,7.5 H13" /><Path Style="{StaticResource IconFill}" Data="M13,7.5 A2.75,2.75 0 1 1 18.5,7.5 A2.75,2.75 0 1 1 13,7.5 Z" /></Grid>
                        <TextBlock Text="Dot" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="None">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,7.5 H17.5" /></Grid>
                        <TextBlock Text="None" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Tick">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,7.5 H16 M13,10.5 L19,4.5" /></Grid>
                        <TextBlock Text="Tick" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>
            <ComboBox x:Name="LineWidthPicker" Width="84" SelectedIndex="1" SelectionChanged="OnStyleChanged" ToolTip="Line weight" Margin="4,0,0,0">
                <ComboBoxItem Content="0.5 pt" Tag="0.5" />
                <ComboBoxItem Content="1 pt" Tag="1" />
                <ComboBoxItem Content="2 pt" Tag="2" />
                <ComboBoxItem Content="3 pt" Tag="3" />
            </ComboBox>
            <Separator />
            <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8D2;" ToolTip="Text size" Margin="8,0,2,0" />
            <!-- Every installed font, each shown in itself. On for text, callouts, tags and measurements only. -->
            <ComboBox x:Name="FontPicker" Width="160" IsEnabled="False" SelectionChanged="OnFontChanged" Margin="0,0,4,0"
                      ToolTip="Font of text, callouts, tags and measurements. Select one, or pick its tool, to change it">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" FontFamily="{Binding}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="FontSizePicker" Width="84" SelectedIndex="2" SelectionChanged="OnStyleChanged" ToolTip="Text size for text, callouts and tags">
                <ComboBoxItem Content="8 pt" Tag="8" />
                <ComboBoxItem Content="10 pt" Tag="10" />
                <ComboBoxItem Content="12 pt" Tag="12" />
                <ComboBoxItem Content="14 pt" Tag="14" />
                <ComboBoxItem Content="18 pt" Tag="18" />
                <ComboBoxItem Content="24 pt" Tag="24" />
            </ComboBox>
            <Separator />
            <ComboBox x:Name="ShapePicker" Width="124" SelectedIndex="0" SelectionChanged="OnShapeChanged" ToolTip="Shape the cloud and callout tools mark: a box or circle (click two corners) or a free polygon (click the corners, double-click to close)">
                <ComboBoxItem Tag="Box">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,2.5 H17.5 V11.5 H2.5 Z" /></Grid>
                        <TextBlock Text="Box" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Circle">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,7 A7.5,4.5 0 1 1 17.5,7 A7.5,4.5 0 1 1 2.5,7 Z" /></Grid>
                        <TextBlock Text="Circle" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Polygon">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M3.5,11.5 L2.5,5.5 L9.5,2.5 L17.5,4.5 L14.5,11.5 Z" /></Grid>
                        <TextBlock Text="Free poly" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>
            <ComboBox x:Name="LineStylePicker" Width="128" SelectedIndex="0" SelectionChanged="OnLineStyleChanged" Margin="4,0,0,0" ToolTip="Outline of the area a callout points at: a cloud, dashes, a line or nothing. Changes the selected one too. Remembered for next time">
                <ComboBoxItem Tag="Cloud">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M4,4.5 A2,2 0 0 1 8,4.5 A2,2 0 0 1 12,4.5 A2,2 0 0 1 16,4.5 A2.5,2.5 0 0 1 16,9.5 A2,2 0 0 1 12,9.5 A2,2 0 0 1 8,9.5 A2,2 0 0 1 4,9.5 A2.5,2.5 0 0 1 4,4.5 Z" /></Grid>
                        <TextBlock Text="Cloud" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Dashed">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,2.5 H17.5 V11.5 H2.5 Z" StrokeDashArray="3 2" /></Grid>
                        <TextBlock Text="Dashed" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Solid">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,2.5 H17.5 V11.5 H2.5 Z" /></Grid>
                        <TextBlock Text="Solid" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="None">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,2.5 H17.5 V11.5 H2.5 Z" StrokeDashArray="1 2" Opacity="0.4" /></Grid>
                        <TextBlock Text="None" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>
            <ComboBox x:Name="FillPicker" Width="136" SelectedIndex="0" SelectionChanged="OnFillChanged" Margin="4,0,0,0"
                      ToolTip="Fill colour of rectangles and masks. Changes the selected closed shapes too: rectangles, clouds and areas, closed CAD polylines and circles">
                <ComboBoxItem Content="No fill" Tag="None" />
                <ComboBoxItem Content="White fill" Tag="#FFFFFF" />
                <ComboBoxItem Content="Yellow fill" Tag="#FFFF00" />
                <ComboBoxItem Content="Red fill" Tag="#E53935" />
                <ComboBoxItem Content="Blue fill" Tag="#1E88E5" />
                <ComboBoxItem Content="Green fill" Tag="#43A047" />
                <ComboBoxItem Content="Black fill" Tag="#000000" />
                <ComboBoxItem x:Name="CustomFillItem" Content="Custom…" />
            </ComboBox>
            <ComboBox x:Name="HatchPicker" Width="148" SelectedIndex="0" SelectionChanged="OnHatchPatternChanged" Margin="4,0,0,0" ToolTip="Fill type: hatch lines, crosshatch or solid. For filled rectangles and the CAD hatch tool (which draws in the fill colour), and changes the selected closed shapes and hatches too. Remembered for next time">
                <ComboBoxItem Tag="Lines">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,2.5 H17.5 V11.5 H2.5 Z M2.5,8.5 L8.5,2.5 M6.5,11.5 L15.5,2.5 M12.5,11.5 L17.5,6.5" /></Grid>
                        <TextBlock Text="Hatch" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Crosshatch">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconLine}" Data="M2.5,2.5 H17.5 V11.5 H2.5 Z M2.5,8.5 L8.5,2.5 M6.5,11.5 L15.5,2.5 M12.5,11.5 L17.5,6.5 M2.5,5.5 L8.5,11.5 M6.5,2.5 L15.5,11.5 M12.5,2.5 L17.5,7.5" /></Grid>
                        <TextBlock Text="Crosshatch" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
                <ComboBoxItem Tag="Solid">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="14" Margin="0,0,6,0"><Path Style="{StaticResource IconFill}" Data="M2,2 H18 V12 H2 Z" /></Grid>
                        <TextBlock Text="Solid fill" VerticalAlignment="Center" />
                    </StackPanel>
                </ComboBoxItem>
            </ComboBox>
            <Separator />
            <!-- Tool templates: the code puts a button here for each one. Hidden for now. -->
            <StackPanel x:Name="TemplateBar" Orientation="Horizontal" Visibility="Collapsed" />
            <Button Click="OnSaveTemplate" Visibility="Collapsed" ToolTip="Save the tool in use and its style as a template, under a name. Markups drawn with it carry the name as their subject, for whoever (or whatever) reads the file">
                <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE710;" />
            </Button>
        </ToolBar>

        <!-- One tab per open document: just the headers. The page view below is shared and shows the selected tab's document. -->
        <TabControl x:Name="TabStrip" DockPanel.Dock="Top" Visibility="Collapsed" SelectionChanged="OnTabSelected" Padding="0" Margin="4,2,4,0" />

        <!-- The selected placed sheet's settings. -->
        <Border x:Name="SheetControls" DockPanel.Dock="Top" Visibility="Collapsed" Padding="10,4"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;" />
                <TextBlock Text="Placed sheet" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock Text="Opacity" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="SheetOpacity" Width="150" Minimum="5" Maximum="100" SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                        ValueChanged="OnSheetOpacityChanged" PreviewMouseLeftButtonUp="OnSheetOpacityReleased" ToolTip="How strongly the sheet shows over the drawing" />
                <TextBlock x:Name="SheetOpacityText" Width="44" VerticalAlignment="Center" Margin="8,0,12,0" />
                <CheckBox x:Name="SheetTint" Content="In the line colour" Checked="OnSheetTint" Unchecked="OnSheetTint" VerticalAlignment="Center" Margin="0,0,16,0"
                          ToolTip="Draw all of the sheet's lines in the colour picked at the top (Colour), to tell them apart from the drawing" />
                <Button Click="OnSheetClip" Margin="0,0,6,0" ToolTip="Keep only part of the sheet: click two opposite corners of the part to keep, for example to leave out its title block">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" /><TextBlock Style="{StaticResource Label}" Text="Clip…" /></StackPanel>
                </Button>
                <Button x:Name="SheetShowAll" Click="OnSheetShowAll" Margin="0,0,6,0" ToolTip="Undo the clip: show the whole sheet again">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE740;" /><TextBlock Style="{StaticResource Label}" Text="Show all" /></StackPanel>
                </Button>
                <Button Click="OnSheetAlign" Margin="0,0,6,0" ToolTip="Line it up: click two points on the sheet (grid crossings), then the same two on the drawing. It moves and scales to match">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C5;" /><TextBlock Style="{StaticResource Label}" Text="Align…" /></StackPanel>
                </Button>
                <Button Click="OnSheetAccept" Style="{DynamicResource AccentButtonStyle}" ToolTip="Done editing the sheet: back to the drawing and its markups. Click the sheet's edge to edit it again">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FB;" /><TextBlock Style="{StaticResource Label}" Text="Accept" /></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Info bar while comparing, so it's obvious the view isn't the plain drawing. -->
        <Border x:Name="CompareControls" DockPanel.Dock="Top" Visibility="Collapsed" Padding="10,6"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="OnStopCompare" ToolTip="Drop the comparison: back to the drawing and its markups (auto-clouds stay on the drawing)" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE711;" /><TextBlock Style="{StaticResource Label}" Text="Stop compare" /></StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Click="OnAcceptCompare" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="Carry on in the overlay (every page, as shown): it becomes the open document, to mark up. Your markups and auto-clouds, and the page scales, move onto it. Save As writes it to a file">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8FB;" /><TextBlock Style="{StaticResource Label}" Text="Accept" /></StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="CompareView" Width="110" SelectedIndex="0" SelectionChanged="OnCompareViewChanged" ToolTip="Which revision to show" Margin="0,0,6,0">
                        <ComboBoxItem Content="Both" />
                        <ComboBoxItem Content="Old only" />
                        <ComboBoxItem Content="New only" />
                    </ComboBox>
                    <Button x:Name="AlignButton" Click="OnAlign" Margin="0,0,6,0" ToolTip="Line up the revisions: click two matching points (grid intersections) on the old one, then the same two on the new one. Esc cancels">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7C5;" /><TextBlock Style="{StaticResource Label}" Text="Align…" /></StackPanel>
                    </Button>
                    <Button Click="OnAutoCloud" Margin="0,0,6,0" ToolTip="Put a cloud around every change on this page (in the colour picked above). Clouds are normal markups: edit, delete and save them as usual">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE753;" /><TextBlock Style="{StaticResource Label}" Text="Auto-cloud" /></StackPanel>
                    </Button>
                    <Button Click="OnExportOverlay" ToolTip="Save this overlay as a one-page PDF with a legend, to print or send">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE749;" /><TextBlock Style="{StaticResource Label}" Text="Export…" /></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" />
                    <TextBlock Text="Comparing" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="CompareLegend" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Markup tools are off: Accept to mark up the overlay, or Stop compare" VerticalAlignment="Center" Margin="14,0,0,0"
                               FontStyle="Italic" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="6,0" Visibility="Collapsed">
            <StatusBarItem>
                <ToggleButton x:Name="PagesToggle" IsChecked="True" Click="OnTogglePages" Padding="6,3" MinWidth="0" MinHeight="0" ToolTip="Show or hide the page list">
                    <TextBlock Style="{StaticResource PageIcon}" Text="&#xE8A9;" />
                </ToggleButton>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="SnapToggle" Content="Snap" IsChecked="True" Click="OnSnapToggled" MinWidth="0"
                              ToolTip="Snap points to the drawing's line ends, crossings, circle centres, midpoints and lines. Hold Ctrl to place a point without snapping" />
                    <Button x:Name="SnapSettingsButton" Style="{StaticResource PageButton}" Click="OnSnapSettings" Margin="2,0,0,0"
                            ToolTip="Snap settings: pick what points snap to">
                        <TextBlock Style="{StaticResource PageIcon}" Text="&#xE713;" />
                    </Button>
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <!-- Turn the page in view, drawing and markups together; saved with the file. Also in the Tools menu. -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RotateCounterClockwiseButton" Style="{StaticResource PageButton}" Click="OnRotateCounterClockwise" ToolTip="Rotate the page counter-clockwise">
                        <Viewbox Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform><ScaleTransform ScaleX="-1" /></Viewbox.RenderTransform>
                            <Grid Style="{StaticResource DrawnIcon}">
                                <Path Style="{StaticResource IconLine}" Data="{StaticResource IconRotate}" StrokeThickness="1.4" />
                                <Path Style="{StaticResource IconFill}" Data="{StaticResource IconRotateHead}" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="RotateClockwiseButton" Style="{StaticResource PageButton}" Click="OnRotateClockwise" ToolTip="Rotate the page clockwise">
                        <Viewbox Width="14" Height="14">
                            <Grid Style="{StaticResource DrawnIcon}">
                                <Path Style="{StaticResource IconLine}" Data="{StaticResource IconRotate}" StrokeThickness="1.4" />
                                <Path Style="{StaticResource IconFill}" Data="{StaticResource IconRotateHead}" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <!-- Half a turn over the top, and 180 under it. -->
                    <Button x:Name="Rotate180Button" Style="{StaticResource PageButton}" Click="OnRotate180" ToolTip="Rotate the page 180°">
                        <Viewbox Width="14" Height="14">
                            <Grid Style="{StaticResource DrawnIcon}">
                                <Path Style="{StaticResource IconLine}" Data="M3.5,11 A6.5,6.5 0 0 1 16.5,10" StrokeThickness="1.4" />
                                <Path Style="{StaticResource IconFill}" Data="M14,9 L19,9 L16.5,13 Z" />
                                <TextBlock Text="180" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-1" />
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <!-- First, previous, the page (type a number and press Enter), next, last. -->
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="FirstPageButton" Style="{StaticResource PageButton}" Click="OnFirstPage" ToolTip="First page (Home)">
                        <TextBlock Style="{StaticResource PageIcon}" Text="&#xE892;" />
                    </Button>
                    <Button x:Name="PreviousPageButton" Style="{StaticResource PageButton}" Click="OnPreviousPage" ToolTip="Previous page (Page Up)">
                        <TextBlock Style="{StaticResource PageIcon}" Text="&#xE76B;" />
                    </Button>
                    <TextBox x:Name="PageBox" Width="84" Padding="4,1" MinHeight="0" Margin="4,0" HorizontalContentAlignment="Center"
                             PreviewMouseLeftButtonDown="OnSelectAllMouseDown" GotKeyboardFocus="OnSelectAllGotFocus"
                             KeyDown="OnPageBoxKeyDown" LostKeyboardFocus="OnPageBoxLostFocus" ToolTip="Page: type a number and press Enter" />
                    <Button x:Name="NextPageButton" Style="{StaticResource PageButton}" Click="OnNextPage" ToolTip="Next page (Page Down)">
                        <TextBlock Style="{StaticResource PageIcon}" Text="&#xE76C;" />
                    </Button>
                    <Button x:Name="LastPageButton" Style="{StaticResource PageButton}" Click="OnLastPage" ToolTip="Last page (End)">
                        <TextBlock Style="{StaticResource PageIcon}" Text="&#xE893;" />
                    </Button>
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PageButton}" Click="OnFit" ToolTip="Fit the page in the window (Ctrl+0, or double-click the mouse wheel)" Margin="0,0,4,0">
                        <TextBlock Style="{StaticResource PageIcon}" Text="&#xE9A6;" />
                    </Button>
                    <TextBox x:Name="ZoomBox" Width="56" Padding="4,1" MinHeight="0" HorizontalContentAlignment="Right"
                             KeyDown="OnZoomBoxKeyDown" LostKeyboardFocus="OnZoomBoxLostFocus" ToolTip="Zoom: type a percentage and press Enter" />
                    <TextBlock Text="%" VerticalAlignment="Center" Margin="3,0,0,0" />
                </StackPanel>
            </StatusBarItem>
            <!-- The CAD tools' sizes, instead of pop-ups. They follow the cursor; typing a number while drawing goes in here, Enter applies it. -->
            <StatusBarItem x:Name="CadInputBar" Visibility="Collapsed">
                <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="10,0,0,0" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CAD" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <ComboBox x:Name="CadCircleSizeKind" MinHeight="0" Padding="8,1" Margin="0,0,6,0" SelectedIndex="0" SelectionChanged="OnCadCircleSizeKindChanged"
                                  ToolTip="Type the circle's diameter or its radius">
                            <ComboBoxItem Content="Diameter" />
                            <ComboBoxItem Content="Radius" />
                        </ComboBox>
                        <TextBlock x:Name="CadInputLabel" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="CadInputFirst" Width="80" Padding="4,1" MinHeight="0" HorizontalContentAlignment="Right" KeyDown="OnCadInputKeyDown" TextChanged="OnCadInputTextChanged"
                                 PreviewMouseLeftButtonDown="OnSelectAllMouseDown" GotKeyboardFocus="OnSelectAllGotFocus"
                                 PreviewTextInput="OnCadInputPreviewTextInput" PreviewKeyDown="OnCadInputPreviewKeyDown" />
                        <TextBlock x:Name="CadInputSecondLabel" Text="× length" VerticalAlignment="Center" Margin="6,0,6,0" />
                        <TextBox x:Name="CadInputSecond" Width="80" Padding="4,1" MinHeight="0" HorizontalContentAlignment="Right" KeyDown="OnCadInputKeyDown" TextChanged="OnCadInputTextChanged"
                                 PreviewMouseLeftButtonDown="OnSelectAllMouseDown" GotKeyboardFocus="OnSelectAllGotFocus"
                                 PreviewTextInput="OnCadInputPreviewTextInput" PreviewKeyDown="OnCadInputPreviewKeyDown" />
                        <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
            </StatusBarItem>
            <StatusBarItem><TextBlock x:Name="NoticeStatus" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <Button x:Name="ScaleButton" Click="OnScale" Padding="8,1" MinHeight="0" FontWeight="SemiBold" ToolTip="Drawing scale of this page, for measuring: pick one, or calibrate on a known length" />
            </StatusBarItem>
            <!-- On the right, so its changing width doesn't shift the CAD boxes. -->
            <StatusBarItem DockPanel.Dock="Right" Margin="0,0,6,0"><TextBlock x:Name="CursorStatus" ToolTip="Cursor position on the sheet, from its bottom-left corner" /></StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right"><TextBlock x:Name="MeasureStatus" FontWeight="SemiBold" /></StatusBarItem>
        </StatusBar>

        <!-- Drawing tools, down the right. Leaders and lines snap like the measure tool; Shift keeps them straight across or up; Ctrl turns snapping off while held. -->
        <ToolBarTray DockPanel.Dock="Right" Orientation="Vertical" IsLocked="True">
            <ToolBar x:Name="ToolsBar" Padding="2,4">
                <ToolBar.Resources>
                    <!-- One width for every button in the bar: each stretches to the widest, with its icon in the middle.
                         Switched off (the CAD tools until the sheet has a scale), a button fades well back. -->
                    <Style x:Key="{x:Static ToolBar.RadioButtonStyleKey}" TargetType="RadioButton" BasedOn="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3" /></Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Margin" Value="1" />
                        <Setter Property="Padding" Value="8,5" />
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </ToolBar.Resources>
                <RadioButton x:Name="SelectTool" Tag="Select" IsChecked="True" Checked="OnToolChecked"
                             ToolTip="Select (V): click to select, drag a window over empty space to select what it touches, drag to move. Shift+click or Shift+window adds markups or takes selected ones out, double-click or F2 to edit text, Delete to remove. Ctrl+click a cloud edge adds a corner, Ctrl+click a corner removes it">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8B0;" />
                </RadioButton>
                <RadioButton x:Name="SelectTextTool" Tag="SelectText" Checked="OnToolChecked"
                             ToolTip="Select text (S): drag over text, double-click a word, Ctrl+A for the whole page. Ctrl+C copies; right-click to copy or highlight it">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8C1;" />
                </RadioButton>
                <Separator />
                <RadioButton x:Name="TextTool" Tag="Text" Checked="OnToolChecked" ToolTip="Text (T): click to place it, or drag a box for it to wrap in. Enter to finish, Shift+Enter for a new line">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8AC;" />
                </RadioButton>
                <RadioButton x:Name="CalloutTool" Tag="Callout" Checked="OnToolChecked" ToolTip="Callout (C): mark the area (shape and outline picked at the top), then click where the text goes. Esc cancels">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconLabel}" />
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconLeader}" />
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconBox}" />
                        <Path Style="{StaticResource IconFill}" Data="{StaticResource IconArrow}" />
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="TagTool" Tag="Tag" Checked="OnToolChecked" ToolTip="Tag (G): click the spot the arrow points at, then where the text goes">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconLabel}" />
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconTagLeader}" />
                        <Path Style="{StaticResource IconFill}" Data="{StaticResource IconTagArrow}" />
                    </Grid>
                </RadioButton>

                 <RadioButton x:Name="CloudTool" Tag="Cloud" Checked="OnToolChecked" ToolTip="Cloud (K): mark the area in the shape picked at the top. Esc cancels">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconCloud}" />
                    </Grid>
                </RadioButton>               
                <RadioButton x:Name="PenTool" Tag="Pen" Checked="OnToolChecked" ToolTip="Pen (P): drag to draw freehand, in the line weight">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xEE56;" />
                </RadioButton>
                <RadioButton x:Name="HighlightTool" Tag="Highlight" Checked="OnToolChecked" ToolTip="Highlight (H): drag like a marker pen">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7E6;" />
                </RadioButton>
                <RadioButton x:Name="LineTool" Tag="Line" Checked="OnToolChecked" ToolTip="Line (L): click the start (where the arrow goes, if on), then the end">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconStraightLine}" />
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="RectangleTool" Tag="Rectangle" Checked="OnToolChecked" ToolTip="Rectangle (R): click one corner, then the opposite corner">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE739;" />
                </RadioButton>
                <RadioButton x:Name="MaskTool" Tag="Mask" Checked="OnToolChecked" ToolTip="Mask (W): a white box without outline to blank out part of the drawing. Click one corner, then the opposite corner. Pick another fill at the top">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconFill}" Data="M3,5 H17 V15 H3 Z" />
                    </Grid>
                </RadioButton>
                <Separator />
                <RadioButton x:Name="MeasureTool" Tag="Measure" Checked="OnToolChecked"
                             ToolTip="Measure (M): click points on the drawing; they snap to line ends, crossings, circle centres, midpoints, square off the last point and lines (pick which next to Snap in the status bar). Double-click or Enter ends a distance or length; click the first point again for an area. Measurements clear on Esc or another tool (CAD dimensions stay). Shift: straight across or up. Ctrl: no snapping. Set the scale in the status bar; with none set, it takes the 1:### written furthest bottom right on the sheet (shown orange until confirmed)">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xED5E;" />
                </RadioButton>
                <Button x:Name="CalibrateButton" Click="OnCalibrate"
                        ToolTip="Calibrate the scale: click both ends of a known length (a dimension or grid spacing), then type its real length. Measurements then show real lengths">
                    <Grid>
                        <TextBlock Style="{StaticResource ToolIcon}" Text="&#xED5E;" />
                        <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE713;" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-3" />
                    </Grid>
                </Button>
                <!-- Check text overlaps and Place PDF or image are in the Tools menu only: these hidden buttons stay, as its items take their state and tips from them. -->
                <Button x:Name="OverlapsButton" Click="OnFindOverlaps" Visibility="Collapsed"
                        ToolTip="Check text overlaps: puts a cloud (in the colour picked at the top) around text on this page that lines, arrows or fills run through. Clouds are normal markups: delete the ones you don't need, or undo them all at once">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE9D5;" />
                </Button>
                <Button x:Name="PlaceSheetButton" Click="OnPlaceSheet" Visibility="Collapsed"
                        ToolTip="Place a PDF page or an image on this page, such as the architect's plan over the structure: see-through, in one colour if you like, clipped, and lined up on two points. Ctrl+V pastes a copied image or PDF file the same way">
                    <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8B9;" />
                </Button>
                <!-- Experimental CAD tools: on once the sheet has a scale, as they take real lengths. Set apart with a heading. -->
                <Border Height="2" Margin="0,10,0,4" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="CAD" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="Experimental CAD tools: on once the sheet has a scale" />
                <RadioButton x:Name="CadLineTool" Tag="CadLine" Checked="OnToolChecked" IsEnabled="False"
                             ToolTip="CAD line (experimental): click the start, then the end, or type its length and press Enter (it goes towards the cursor). Ctrl: horizontal or vertical (like F8). Esc cancels. For more points use the polyline. Needs the sheet's scale">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconCadLine}" />
                        <Path Style="{StaticResource IconFill}" Data="{StaticResource IconCadLineEnds}" />
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="CadPolylineTool" Tag="CadPolyline" Checked="OnToolChecked" IsEnabled="False"
                             ToolTip="CAD polyline (experimental): click its points, or type each length and press Enter; double-click, Enter or right-click ends it, a click on the first point closes it. Ctrl: horizontal or vertical. Esc cancels">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconCadPolyline}" />
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="CadRectangleTool" Tag="CadRectangle" Checked="OnToolChecked" IsEnabled="False"
                             ToolTip="CAD rectangle (experimental): click one corner, then the opposite corner. Or after the first corner, type its width and length in the status bar (Enter between them); it goes towards the cursor">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconCadRectangle}" />
                        <Path Style="{StaticResource IconFill}" Data="{StaticResource IconCadRectangleCorners}" />
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="CadCircleTool" Tag="CadCircle" Checked="OnToolChecked" IsEnabled="False"
                             ToolTip="CAD circle (experimental): click the centre, then a point on the circle, or type its diameter or radius in the status bar and press Enter">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconCadCircle}" />
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="CadOffsetTool" Tag="CadOffset" Checked="OnToolChecked" IsEnabled="False"
                             ToolTip="CAD offset (experimental): click a CAD line or circle, then the side to copy it to, at the distance in the status bar (type a new one there and press Enter). Repeat for more copies">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconCadOffset}" />
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="CadTrimTool" Tag="CadTrim" Checked="OnToolChecked" IsEnabled="False"
                             ToolTip="CAD trim (experimental): click the piece of a CAD line or circle to cut away, up to the lines crossing it (a line nothing crosses is deleted), or drag a window from empty space: every line its edge crosses is trimmed there. Shift turns it into extend: a clicked line end (or each line the window crosses) runs on to the next line, or to the page edge">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconCadTrim}" />
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="CadHatchTool" Tag="CadHatch" Checked="OnToolChecked" IsEnabled="False"
                             ToolTip="CAD hatch (experimental): click inside a region closed off by CAD lines or circles to fill it, as hatch, crosshatch or solid (picked at the top) in the colour picked">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconCadHatch}" />
                    </Grid>
                </RadioButton>
                <RadioButton x:Name="CadDimensionTool" Tag="CadDimension" Checked="OnToolChecked" IsEnabled="False"
                             ToolTip="CAD dimension (experimental): click two points (they snap to the drawing, CAD lines and markups), then where the dimension line goes. Double-click a dimension with the Select tool to type a new length: the shape it ends on stretches or moves to fit">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconCadDimension}" />
                    </Grid>
                </RadioButton>
                <Button x:Name="CadJoinButton" Click="OnCadJoin" IsEnabled="False"
                        ToolTip="Join CAD lines (experimental): select the lines with the Select tool, then click this. They become one polyline with clean corners, closed if they go all round">
                    <Grid Style="{StaticResource DrawnIcon}">
                        <Path Style="{StaticResource IconLine}" Data="{StaticResource IconCadJoin}" />
                        <Path Style="{StaticResource IconFill}" Data="{StaticResource IconCadJoinCorners}" />
                    </Grid>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Border x:Name="PagePanel" DockPanel.Dock="Left" Width="150"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <!-- Ctrl- or Shift-click picks several pages, for the right-click menu; the first picked is the one in view. -->
            <ListBox x:Name="PageList" SelectionChanged="OnPageSelected" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContextMenuOpening="OnPageMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="InsertPageItem" Header="_Insert New Sheet…" Click="OnInsertPage" ToolTip="A blank sheet after the picked pages: A4 to A0 or your own size">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7C3;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="DeletePagesItem" Header="_Delete" Click="OnDeletePages">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74D;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ExportPagesItem" Header="_Export As…" Click="OnExportPages" ToolTip="A new PDF of the picked pages, with their markups">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE792;" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MovePagesUpItem" Header="Move _Up" Click="OnMovePagesUp">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74A;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MovePagesDownItem" Header="Move Do_wn" Click="OnMovePagesDown">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74B;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MovePagesToTopItem" Header="Move to _Top" Click="OnMovePagesToTop" />
                        <MenuItem x:Name="MovePagesToEndItem" Header="Move to _End" Click="OnMovePagesToEnd" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:PageThumbnail">
                        <StackPanel Margin="0,4" HorizontalAlignment="Center">
                            <Border Width="104" Height="104" Background="Transparent">
                                <!-- White behind the page, as in the main view: pages draw transparent, and dark mode would show through. -->
                                <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding Image}" Stretch="Uniform" Loaded="OnThumbnailShown" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,3,0,0" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid>
            <ScrollViewer x:Name="Scroller" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" Focusable="False"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnWheel" PreviewMouseDown="OnMouseDown"
                          PreviewMouseMove="OnMouseMove" PreviewMouseUp="OnMouseUp" LostMouseCapture="OnScrollerLostMouseCapture" MouseLeave="OnScrollerMouseLeave">
                <!-- The drawing stays white in dark mode: it's a drawing. -->
                <Border Background="White" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <!-- The border stays outside the zoom: a zoomed 1-unit border would push the page off whole pixels. -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="Zoom" />
                        </Grid.LayoutTransform>
                        <!-- Stretch None + the bitmap's DPI (set in code) keep it 1:1 with screen pixels; any stretching blurs thin lines.
                             No layout rounding here: inside the zoom it would resize the bitmap by a fraction of a pixel.
                             The window's layout rounding puts the zoomed grid on whole pixels. The markup canvas sets the page size. -->
                        <Image x:Name="PageImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" UseLayoutRounding="False"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- Zoomed in past what one page image can hold: the part in view, drawn sharp over it (placed in code). -->
                        <Image x:Name="SharpPatch" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" UseLayoutRounding="False"
                               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                        <!-- Canvas units are PDF points; this scale turns them into screen units (96 per inch). -->
                        <local:MarkupCanvas x:Name="MarkupLayer">
                            <local:MarkupCanvas.LayoutTransform>
                                <ScaleTransform ScaleX="1.3333333333333333" ScaleY="1.3333333333333333" />
                            </local:MarkupCanvas.LayoutTransform>
                        </local:MarkupCanvas>
                    </Grid>
                </Border>
            </ScrollViewer>

            <!-- Start screen while no file is open. -->
            <Border x:Name="StartPanel" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                    <Image Source="icon.png" Width="96" Height="96" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Open a PDF or drop one here" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,24">
                        <Button Click="OnOpen" Padding="16,6">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /><TextBlock Style="{StaticResource Label}" Text="Open…" /></StackPanel>
                        </Button>
                        <Button Click="OnNew" Padding="16,6" Margin="8,0,0,0" ToolTip="A blank sheet to draw on: A4 to A0 or your own size">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" /><TextBlock Style="{StaticResource Label}" Text="New…" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="RecentHeading" Text="Recent" Style="{StaticResource GroupLabel}" Margin="4,0,0,6" FontSize="13" />
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnRecentFile" Tag="{Binding}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                        Margin="0,2" Padding="10,6" ToolTip="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Converter={x:Static local:PathParts.FileName}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Converter={x:Static local:PathParts.Folder}}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
    <!-- "Show me the tricks": dims the window and lights up one area at a time. Transparent, so it takes every click. -->
    <Canvas x:Name="TricksOverlay" Visibility="Collapsed" Background="Transparent" MouseDown="OnTricksClick" SizeChanged="OnTricksResized" />
    </Grid>
</Window>
